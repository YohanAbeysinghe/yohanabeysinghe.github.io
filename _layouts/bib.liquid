---
---
{% comment %}Small site override of al_folio_core's bibliography view. All metadata lives in papers.bib.{% endcomment %}
<article id="{{ entry.key }}" class="research-entry{% if entry.preview %} has-preview{% endif %}" data-venue="{{ entry.abbr | escape }}">
  {% if entry.preview %}
    <div class="research-visual">
      <span class="venue-badge">
        {{- entry.abbr }}
        {{ entry.year -}}
      </span>
      <a
        class="research-figure"
        href="{{ entry.preview | relative_url }}"
        aria-label="Enlarge figure for {{ entry.title | escape }}"
        title="Enlarge figure"
      >
        <img
          class="research-preview"
          src="{{ entry.preview | relative_url }}"
          alt="{{ entry.preview_alt | escape }}"
          loading="lazy"
          decoding="async"
          width="{{ entry.preview_width }}"
          height="{{ entry.preview_height }}"
        >
      </a>
    </div>
  {% endif %}
  <div class="research-copy">
    <h3 class="research-title">
      <a href="{{ entry.paper }}">{{ entry.title }}</a>
    </h3>
    <p class="research-authors">
      {%- for author in entry.author_array -%}
        {%- if site.scholar.last_name contains author.last and site.scholar.first_name contains author.first -%}
          <strong>
            {{- author.first }}
            {{ author.last -}}
          </strong>
        {%- else -%}
          {{ author.first }}
          {{ author.last }}
        {%- endif -%}
        {%- unless forloop.last -%}{{ ', ' }}{%- endunless -%}
      {%- endfor -%}
    </p>
    <p class="research-venue">
      {{ entry.venue }} · {{ entry.year }}
      <span class="publication-status">· {{ entry.status }}</span>
    </p>
    {% if entry.summary %}
      <p class="research-summary">{{ entry.summary }}</p>
    {% endif %}
    {% if entry.contribution %}
      <p class="research-contribution"><strong>My contribution:</strong> {{ entry.contribution }}</p>
    {% endif %}
    <nav class="research-links" aria-label="Links for {{ entry.title | escape }}">
      {% if entry.paper -%}
        <a class="paper-link" href="{{ entry.paper }}">Paper</a>
      {%- endif %}
      {% if entry.arxiv -%}
        <a class="paper-link" href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a>
      {%- endif %}
      {% if entry.website -%}
        <a class="project-link" href="{{ entry.website }}">Project</a>
      {%- endif %}
      {% if entry.code -%}
        <a class="code-link" href="{{ entry.code }}">Code</a>
      {%- endif %}
      {% if entry.video -%}
        <a class="video-link" href="{{ entry.video }}">Video</a>
      {%- endif %}
    </nav>
  </div>
</article>
