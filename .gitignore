# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Track Gemfile.lock for reproducible local and GitHub Actions builds.

# Ignore files created by npm
node_modules
# Keep package-lock.json for the optional formatter.

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore folders related to IDEs
.vscode/
src/

# Local Jekyll state, verification output, and operating-system files
.jekyll-cache/
.jekyll-metadata
local-reports/
.DS_Store
*.log
al-folio-upgrade-report.md
